{
  "name": "agentflow-mcp",
  "version": "0.1.0",
  "description": "Enterprise architecture knowledge MCP server for the Agentic POC demo",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "tldjs@2.3.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
